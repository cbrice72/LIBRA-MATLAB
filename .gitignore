###############################################################################
## Ignore MATLAB temporary files and files generated by popular packages or
## add-ons. 
##
## Modified from https://github.com/github/gitignore/blob/main/
###############################################################################

###############################################################################
## MATLAB.gitignore
###############################################################################

# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
*.bak

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag

###############################################################################
## LIBRA MATLAB
###############################################################################

# Script-generated files
**/output/*
